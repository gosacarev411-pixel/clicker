body {
    margin: 0;
    padding: 0;
    background-color: #0f172a;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
}

.container {
    text-align: center;
}

h1 {
    font-size: 24px;
    margin-bottom: 20px;
    color: #94a3b8;
}

.score-box {
    margin-bottom: 40px;
}

#score {
    font-size: 48px;
    font-weight: bold;
    color: #facc15;
}

.score-box p {
    margin: 5px 0 0;
    color: #64748b;
}

.coin-container {
    display: inline-block;
    cursor: pointer;
    user-select: none;
    transition: transform 0.1s ease;
}

.coin-container:active {
    transform: scale(0.92);
}

.coin {
    font-size: 120px;
    filter: drop-shadow(0 10px 20px rgba(250, 204, 21, 0.3));
}
